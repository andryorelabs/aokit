{
  "$schema": "/home/andryore/.claude/forge/schema/forge.config.schema.json",
  "//": "Generated by `forge init` on 2026-11-03. Every value below is either autodetected or a built-in default — review before relying on it, especially repo.trunk if it was not detected (see the summary this command printed). `commands` is prose-only (see the schema) — the /forge command reads it directly, this CLI never does.",
  "version": 1,
  "repo": {
    "trunk": "main",
    "remote": "origin"
  },
  "ticket": {
    "idPattern": "^AO-\\d+$",
    "branchPrefix": "ao"
  },
  "concurrency": {
    "waveSize": 4,
    "maxLiveWorkers": "auto",
    "runIdleThresholdMs": 5400000
  },
  "tracker": {
    "kind": "linear",
    "readyLabel": "ready-for-agent",
    "triageLabels": [
      "needs-triage",
      "needs-info",
      "ready-for-agent",
      "ready-for-human",
      "wontfix"
    ],
    "transitions": {
      "onStart": "worker",
      "onPrOpen": "automatic",
      "onPrMerge": "automatic"
    },
    "prReference": "Refs: {id}"
  },
  "preflight": {
    "requiredFiles": [],
    "requiredCommands": []
  },
  "handoff": {
    "maxLines": 60,
    "maxChars": 8000,
    "autoChain": true,
    "launcher": "auto",
    "permissionMode": "bypassPermissions"
  },
  "pr": {
    "autoMerge": true,
    "mergeMethod": "squash",
    "maxCiFixAttempts": 2
  },
  "usage": {
    "oversizedReadLines": 400,
    "stalledMinutes": 10
  },
  "models": {
    "worker": {
      "model": "sonnet",
      "effort": "medium"
    },
    "reviewer": {
      "medium": {
        "model": "opus",
        "effort": "medium"
      },
      "high": {
        "model": "opus",
        "effort": "medium"
      }
    },
    "triage": "haiku"
  },
  "review": {
    "highRiskPaths": []
  },
  "commands": {
    "selfCheck": []
  }
}
