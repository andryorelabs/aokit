{
  "name": "@aokit/module",
  "version": "0.2.0",
  "description": "The Module manifest contract for aokit Module authors.",
  "keywords": [
    "aokit",
    "manifest",
    "module",
    "typescript"
  ],
  "homepage": "https://github.com/andryorelabs/aokit#readme",
  "bugs": "https://github.com/andryorelabs/aokit/issues",
  "license": "MIT",
  "author": "Andry Orellana <hello@andryore.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andryorelabs/aokit.git",
    "directory": "packages/module"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalog": "./src/catalog.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=20"
  }
}
