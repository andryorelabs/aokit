{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["registry/**", "registry-src/*/files/**"],
  "workspaces": {
    ".": {
      "entry": ["tools/**/*.test.ts", "registry-src/*/module.ts", "registry-src/*/migrations/*.ts"],
      "ignoreDependencies": ["typescript7", "publint", "@arethetypeswrong/cli"]
    },
    "packages/aokit": {
      "entry": ["test/**/*.test.ts", "src/cli/main.ts"]
    },
    "packages/module": {
      "entry": ["test/**/*.test.ts"]
    }
  }
}
