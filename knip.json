{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/**/*.test.ts"],
      "ignoreDependencies": ["typescript7"]
    },
    "packages/aokit": {
      "entry": ["test/**/*.test.ts"],
      "ignoreDependencies": [
        "@aokit/module",
        "@oxc-parser/binding-wasm32-wasip1",
        "jsonc-parser",
        "magic-string",
        "magicast",
        "oxc-parser",
        "postcss",
        "trpc-cli",
        "yaml",
        "zod"
      ]
    },
    "packages/module": {
      "entry": ["test/**/*.test.ts"],
      "ignoreDependencies": ["zod"]
    }
  }
}
