{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "schedule:weekly"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "pinDigests": true,
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Automerge patch and minor devDependency updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Automerge patch and minor GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Toolchain pin group: oxc, exact pins, never automerged",
      "groupName": "oxc",
      "matchPackageNames": ["oxlint", "oxfmt", "oxlint-tsgolint", "@oxlint/plugins", "oxc-parser"],
      "rangeStrategy": "pin",
      "automerge": false
    },
    {
      "description": "Toolchain pin group: typescript7, exact pin, never automerged",
      "groupName": "typescript7",
      "matchDepNames": ["typescript7"],
      "rangeStrategy": "pin",
      "automerge": false
    },
    {
      "description": "Major updates are never automerged",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
