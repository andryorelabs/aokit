{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices"],
  baseBranchPatterns: ["develop"],
  schedule: ["before 6am on monday"],
  timezone: "UTC",
  dependencyDashboard: true,
  dependencyDashboardTitle: "Dependency dashboard",
  labels: ["dependencies"],
  rangeStrategy: "bump",
  minimumReleaseAge: "3 days",
  osvVulnerabilityAlerts: true,
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
  },
  customManagers: [
    {
      customType: "regex",
      description: "Versions annotated with a '# renovate: datasource=<ds> depName=<name>' comment",
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)\\s*\\n\\s*[A-Za-z0-9_]*VERSION:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?",
      ],
    },
  ],
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/samples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "registry/**",
    "registry-src/**",
  ],
  packageRules: [
    {
      description: "devDependencies keep ranges; the pin groups below override this",
      matchDepTypes: ["devDependencies"],
      rangeStrategy: "bump",
    },
    {
      description: "emnapi packages move together in one pull request",
      groupName: "emnapi",
      matchPackageNames: ["@emnapi/core", "@emnapi/runtime"],
    },
    {
      description: "Automerge patch and minor devDependency updates",
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["patch", "minor"],
      automerge: true,
      minimumReleaseAge: "7 days",
    },
    {
      description: "Automerge patch and minor GitHub Actions updates",
      matchManagers: ["github-actions"],
      addLabels: ["github-actions"],
      matchUpdateTypes: ["patch", "minor"],
      automerge: true,
      minimumReleaseAge: "7 days",
    },
    {
      description: "Toolchain pin group: oxc, exact pins, never automerged",
      groupName: "oxc",
      matchPackageNames: ["oxlint", "oxfmt", "oxlint-tsgolint", "@oxlint/plugins", "oxc-parser"],
      rangeStrategy: "pin",
      automerge: false,
    },
    {
      description: "Toolchain pin group: typescript7, exact pin, never automerged",
      groupName: "typescript7",
      matchDepNames: ["typescript7"],
      allowedVersions: "!/-dev\\./",
      rangeStrategy: "pin",
      automerge: false,
    },
    {
      description: "The real typescript dependency stays below 7",
      matchDepNames: ["typescript"],
      allowedVersions: "<7",
    },
  ],
}
