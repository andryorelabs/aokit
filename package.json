{
  "name": "aokit-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run knip",
    "typecheck": "node_modules/typescript7/bin/tsc --project tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "test": "bun test",
    "registry:build": "bun tools/registry-build/main.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@oxlint/plugins": "1.90.0",
    "@types/bun": "^1.4.4",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@7.1.0-beta"
  },
  "overrides": {
    "@emnapi/core": "2.0.0-beta.2",
    "@emnapi/runtime": "2.0.0-beta.2"
  },
  "packageManager": "bun@1.4.4"
}
