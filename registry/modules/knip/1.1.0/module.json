{
  "$schema": "https://aokit.andryore.dev/schema/module/v1.json",
  "conflicts": [],
  "deps": {
    "devDependencies": {
      "knip": {
        "range": "catalog"
      }
    }
  },
  "env": [],
  "extensionPoints": [],
  "files": [
    {
      "from": "files/knip.json",
      "ownership": "managed",
      "target": "root",
      "to": "knip.json"
    }
  ],
  "migrations": [],
  "name": "knip",
  "ops": [
    {
      "content": "\n## knip\n\nKnip finds unused files, exports and dependencies.\n\nCommands:\n\n- `bun run knip`: report unused code.\n\nKey files:\n\n- `knip.json`: Knip configuration, at the Project root.\n",
      "file": "AGENTS.md",
      "op": "appendRegion",
      "region": "agents",
      "target": "root"
    },
    {
      "file": "package.json",
      "op": "mergeJson",
      "target": "root",
      "value": {
        "scripts": {
          "knip": "knip"
        }
      }
    },
    {
      "extensionPoint": "lint.ignores",
      "op": "mergeJson",
      "range": "^1",
      "value": ["knip-report/**"]
    }
  ],
  "override": [],
  "provides": [
    {
      "capability": "unused-code",
      "cardinality": {
        "max": 1
      }
    }
  ],
  "requires": ["ext:lint.ignores@^1"],
  "schemaVersion": 1,
  "version": "1.1.0"
}
