{
  "$schema": "https://aokit.andryore.dev/schema/module/v1.json",
  "conflicts": [],
  "deps": {
    "dependencies": {
      "@tanstack/react-table": {
        "range": "catalog"
      }
    }
  },
  "env": [],
  "extensionPoints": [],
  "files": [
    {
      "from": "files/example-table.tsx",
      "ownership": "seed",
      "target": "web",
      "to": "src/components/example-table.tsx"
    }
  ],
  "migrations": [],
  "name": "tanstack-table",
  "ops": [
    {
      "content": "\n## tanstack-table\n\nTanStack Table is the headless data table engine.\n\nKey files:\n\n- `src/components/example-table.tsx`: a minimal table built with `useTable`, yours to extend.\n",
      "file": "AGENTS.md",
      "op": "appendRegion",
      "region": "agents",
      "target": "root"
    }
  ],
  "override": [],
  "provides": [
    {
      "capability": "data-table",
      "cardinality": {
        "max": 1
      }
    }
  ],
  "requires": ["web:react"],
  "schemaVersion": 1,
  "version": "1.0.0"
}
