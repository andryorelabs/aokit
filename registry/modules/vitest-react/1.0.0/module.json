{
  "$schema": "https://aokit.andryore.dev/schema/module/v1.json",
  "conflicts": [],
  "deps": {
    "devDependencies": {
      "@vitest/browser-playwright": {
        "range": "catalog",
        "target": "web"
      },
      "happy-dom": {
        "range": "catalog",
        "target": "web"
      },
      "playwright": {
        "range": "catalog",
        "target": "web"
      },
      "vitest-browser-react": {
        "range": "catalog",
        "target": "web"
      }
    }
  },
  "env": [],
  "extensionPoints": [],
  "files": [
    {
      "from": "files/vitest.react.config.ts",
      "ownership": "seed",
      "target": "web",
      "to": "vitest.react.config.ts"
    },
    {
      "from": "files/greeting.dom-test.tsx",
      "ownership": "seed",
      "target": "web",
      "to": "src/greeting.dom-test.tsx"
    },
    {
      "from": "files/greeting.browser-test.tsx",
      "ownership": "seed",
      "target": "web",
      "to": "src/greeting.browser-test.tsx"
    }
  ],
  "migrations": [],
  "name": "vitest-react",
  "ops": [
    {
      "content": "\n## vitest-react\n\nVitest runs React component tests in happy-dom and in a real browser through Playwright.\n\nCommands:\n\n- `bun run test:react`: run the happy-dom and browser projects.\n\nKey files:\n\n- `vitest.react.config.ts`: the two Vitest projects, yours to edit.\n- `src/greeting.dom-test.tsx`: a happy-dom starter test, yours to replace.\n- `src/greeting.browser-test.tsx`: a browser-mode starter test, yours to replace.\n\nInstall the browser once with `bunx playwright install chromium`.\n",
      "file": "AGENTS.md",
      "op": "appendRegion",
      "region": "agents",
      "target": "root"
    },
    {
      "file": "package.json",
      "op": "mergeJson",
      "target": "web",
      "value": {
        "scripts": {
          "test:react": "vitest run -c vitest.react.config.ts"
        }
      }
    }
  ],
  "override": [],
  "provides": [],
  "requires": ["web:react", "test-runner:vitest"],
  "schemaVersion": 1,
  "version": "1.0.0"
}
