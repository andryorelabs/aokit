  "migrations": [],
  "name": "github-ci",
  "ops": [
    {
      "content": "\n## github-ci\n\nGitHub Actions workflows with every action pinned by commit SHA. Package scripts run with `--if-present`, so the workflows work for any selection.\n\nKey files:\n\n- `.github/workflows/ci.yml`: typecheck, lint, format check and test.\n- `.github/workflows/codeql.yml`, `scorecard.yml`: security analysis on public repositories.\n- `.github/workflows/lint-pr.yml`: conventional PR titles.\n- `.github/workflows/lint-workflows.yml`: actionlint and zizmor.\n- `.github/workflows/labels.yml` and `.github/labels.yml`: the label set, synced on `main`.\n- `.github/PULL_REQUEST_TEMPLATE.md` and `.github/ISSUE_TEMPLATE/`: templates you own.\n",
      "file": "AGENTS.md",
      "op": "appendRegion",
      "region": "agents",
      "target": "root"
    }
  ],
  "override": [],
  "provides": [
    {
      "capability": "ci",
      "cardinality": {
        "max": 1
      }
    }
  ],
  "requires": [],
  "schemaVersion": 1,
  "version": "1.0.0"
