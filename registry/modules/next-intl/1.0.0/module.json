{
  "$schema": "https://aokit.andryore.dev/schema/module/v1.json",
  "conflicts": [],
  "deps": {
    "dependencies": {
      "next-intl": {
        "range": "catalog"
      }
    }
  },
  "env": [],
  "extensionPoints": [],
  "files": [
    {
      "from": "files/src/proxy.ts",
      "ownership": "managed",
      "target": "web",
      "to": "src/proxy.ts"
    },
    {
      "from": "files/src/i18n/routing.ts",
      "ownership": "managed",
      "target": "web",
      "to": "src/i18n/routing.ts"
    },
    {
      "from": "files/src/i18n/messages.ts",
      "ownership": "managed",
      "target": "web",
      "to": "src/i18n/messages.ts"
    },
    {
      "from": "files/src/i18n/request.ts",
      "ownership": "managed",
      "target": "web",
      "to": "src/i18n/request.ts"
    },
    {
      "from": "files/src/i18n/provider.tsx",
      "ownership": "managed",
      "target": "web",
      "to": "src/i18n/provider.tsx"
    },
    {
      "from": "files/src/messages/en.json",
      "ownership": "seed",
      "target": "web",
      "to": "src/messages/en.json"
    }
  ],
  "migrations": [],
  "name": "next-intl",
  "ops": [
    {
      "content": "\n## next-intl\n\nnext-intl translates the web Target without locale-prefixed routes; the locale comes from the `NEXT_LOCALE` cookie.\n\nKey files:\n\n- `src/i18n/routing.ts`: the supported locales and the default; add a locale here and a matching file in `src/messages/`.\n- `src/i18n/messages.ts`: the message catalogs shared by the server and client; register each new catalog in `catalogs`.\n- `src/i18n/request.ts`: the server request config that loads the messages.\n- `src/i18n/provider.tsx`: the client provider, registered through `web.providers`.\n- `src/messages/en.json`: the English messages, yours to edit.\n- `src/proxy.ts`: sets the locale cookie from `Accept-Language`; next-intl owns this file, so another Module that needs the proxy must compose with it.\n",
      "file": "AGENTS.md",
      "op": "appendRegion",
      "region": "agents",
      "target": "root"
    },
    {
      "default": "createNextIntlPlugin",
      "extensionPoint": "next.plugins",
      "from": "next-intl/plugin",
      "op": "addImport",
      "range": "^1",
      "target": "web"
    },
    {
      "element": "createNextIntlPlugin(\"./src/i18n/request.ts\")",
      "extensionPoint": "next.plugins",
      "op": "addToArray",
      "range": "^1",
      "target": "web"
    },
    {
      "extensionPoint": "web.providers",
      "from": "./i18n/provider",
      "named": ["IntlProvider"],
      "op": "addImport",
      "range": "^1",
      "target": "web"
    },
    {
      "element": "IntlProvider",
      "extensionPoint": "web.providers",
      "op": "addToArray",
      "range": "^1",
      "target": "web"
    }
  ],
  "override": [
    {
      "file": "web:src/proxy.ts",
      "reason": "replaces the pass-through proxy with locale detection"
    }
  ],
  "provides": [
    {
      "capability": "i18n",
      "cardinality": {
        "max": 1
      }
    }
  ],
  "requires": ["web:app-router", "ext:next.plugins@^1", "ext:web.providers@^1"],
  "schemaVersion": 1,
  "version": "1.0.0"
}
