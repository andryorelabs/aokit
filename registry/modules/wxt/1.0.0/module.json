{
  "$schema": "https://aokit.andryore.dev/schema/module/v1.json",
  "conflicts": [],
  "deps": {
    "dependencies": {
      "@wxt-dev/module-react": {
        "range": "catalog"
      },
      "react": {
        "range": "catalog"
      },
      "react-dom": {
        "range": "catalog"
      },
      "wxt": {
        "range": "catalog"
      }
    },
    "devDependencies": {
      "@types/react": {
        "range": "catalog"
      },
      "@types/react-dom": {
        "range": "catalog"
      },
      "typescript": {
        "range": "catalog"
      }
    }
  },
  "env": [],
  "extensionPoints": [],
  "files": [
    {
      "from": "files/wxt.config.ts",
      "ownership": "seed",
      "target": "extension",
      "to": "wxt.config.ts"
    },
    {
      "from": "files/extension.tsconfig.json",
      "ownership": "seed",
      "target": "extension",
      "to": "tsconfig.json"
    },
    {
      "from": "files/entrypoints/background.ts",
      "ownership": "seed",
      "target": "extension",
      "to": "entrypoints/background.ts"
    },
    {
      "from": "files/entrypoints/popup/index.html",
      "ownership": "seed",
      "target": "extension",
      "to": "entrypoints/popup/index.html"
    },
    {
      "from": "files/entrypoints/popup/main.tsx",
      "ownership": "managed",
      "target": "extension",
      "to": "entrypoints/popup/main.tsx"
    },
    {
      "from": "files/entrypoints/popup/App.tsx",
      "ownership": "seed",
      "target": "extension",
      "to": "entrypoints/popup/App.tsx"
    },
    {
      "from": "files/skill/SKILL.md",
      "ownership": "managed",
      "target": "root",
      "to": ".claude/skills/wxt/SKILL.md"
    }
  ],
  "migrations": [],
  "name": "wxt",
  "ops": [
    {
      "content": "\n## wxt\n\nWXT with React provides the extension Target.\n\nCommands:\n\n- `bun run ext:dev`: launch a browser with the extension and hot reload.\n- `bun run ext:build`: build the extension into `.output/`.\n- `bun run ext:zip`: package the extension for a store.\n\nKey files:\n\n- `wxt.config.ts`: WXT configuration and the manifest source (permissions, name).\n- `entrypoints/background.ts`: the background service worker.\n- `entrypoints/popup/`: the React popup, yours to edit.\n- `tsconfig.json`: TypeScript options for the extension Target, yours to edit.\n\nSkills:\n\n- `.claude/skills/wxt/SKILL.md`: how to add entrypoints, change the manifest and build.\n",
      "file": "AGENTS.md",
      "op": "appendRegion",
      "region": "agents",
      "target": "root"
    },
    {
      "content": "node_modules\n.output\n.wxt\n*.tsbuildinfo\n",
      "file": ".gitignore",
      "op": "appendRegion",
      "region": "wxt",
      "target": "root"
    },
    {
      "file": "package.json",
      "op": "mergeJson",
      "target": "root",
      "value": {
        "scripts": {
          "ext:build": "bun run --cwd {{target:extension}} wxt build",
          "ext:dev": "bun run --cwd {{target:extension}} wxt",
          "ext:zip": "bun run --cwd {{target:extension}} wxt zip"
        }
      }
    }
  ],
  "override": [],
  "provides": [
    {
      "capability": "extension",
      "cardinality": {
        "max": 1
      }
    }
  ],
  "requires": [],
  "schemaVersion": 1,
  "version": "1.0.0"
}
