{
  "$schema": "https://aokit.dev/schema/module/v1.json",
  "conflicts": ["eslint-prettier"],
  "deps": {
    "devDependencies": {
      "oxfmt": {
        "pinGroup": "oxc",
        "range": "catalog"
      },
      "oxlint": {
        "pinGroup": "oxc",
        "range": "catalog"
      }
    }
  },
  "env": [],
  "extensionPoints": [
    {
      "anchor": "/ignorePatterns",
      "file": ".oxlintrc.json",
      "kind": "json",
      "name": "lint.ignores",
      "target": "config",
      "version": "1.0.0"
    }
  ],
  "files": [
    {
      "from": "files/oxlintrc.json",
      "ownership": "managed",
      "target": "config",
      "to": ".oxlintrc.json"
    },
    {
      "from": "files/oxfmtrc.json",
      "ownership": "managed",
      "target": "root",
      "to": ".oxfmtrc.json"
    }
  ],
  "migrations": [],
  "name": "oxc",
  "ops": [
    {
      "file": "package.json",
      "op": "mergeJson",
      "target": "root",
      "value": {
        "scripts": {
          "format": "oxfmt",
          "lint": "oxlint"
        }
      }
    }
  ],
  "override": [],
  "provides": [
    {
      "capability": "lint",
      "cardinality": {
        "max": 1
      }
    },
    {
      "capability": "format",
      "cardinality": {
        "max": 1
      }
    }
  ],
  "requires": [],
  "schemaVersion": 1,
  "version": "1.0.0"
}
