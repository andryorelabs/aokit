{
  "$schema": "https://aokit.andryore.dev/schema/module/v1.json",
  "conflicts": [],
  "deps": {
    "devDependencies": {
      "@arethetypeswrong/cli": {
        "range": "catalog"
      },
      "@size-limit/file": {
        "range": "catalog"
      },
      "@types/bun": {
        "range": "catalog"
      },
      "publint": {
        "range": "catalog"
      },
      "size-limit": {
        "range": "catalog"
      },
      "tsdown": {
        "range": "catalog"
      }
    }
  },
  "env": [],
  "extensionPoints": [],
  "files": [
    {
      "from": "files/tsdown.config.ts",
      "ownership": "managed",
      "target": "lib",
      "to": "tsdown.config.ts"
    },
    {
      "from": "files/tsconfig.lib.json",
      "ownership": "seed",
      "target": "lib",
      "to": "tsconfig.lib.json"
    },
    {
      "from": "files/index.ts",
      "ownership": "seed",
      "target": "lib",
      "to": "src/index.ts"
    },
    {
      "from": "files/cli.ts",
      "ownership": "seed",
      "target": "lib",
      "to": "src/cli.ts"
    },
    {
      "from": "files/skill/SKILL.md",
      "ownership": "managed",
      "target": "root",
      "to": ".claude/skills/tsdown-library/SKILL.md"
    }
  ],
  "migrations": [],
  "name": "tsdown",
  "ops": [
    {
      "content": "\n## tsdown\n\ntsdown bundles the library Target to ESM with type declarations.\n\nCommands:\n\n- `bun run build:lib`: bundle the library to `dist/`.\n- `bun run check:package`: run publint and Are the Types Wrong against the built package.\n- `bun run compile`: compile `src/cli.ts` to a standalone binary with `bun build --compile`.\n\nKey files:\n\n- `tsdown.config.ts`: entry points and output format.\n- `src/index.ts`: the public library entry, yours to edit.\n- `src/cli.ts`: the binary entry for `compile`, yours to edit.\n\nSkills:\n\n- `.claude/skills/tsdown-library/SKILL.md`: how to add entries and keep `exports` in step.\n",
      "file": "AGENTS.md",
      "op": "appendRegion",
      "region": "agents",
      "target": "root"
    },
    {
      "content": "node_modules\ndist\n",
      "file": ".gitignore",
      "op": "appendRegion",
      "region": "tsdown",
      "target": "root"
    },
    {
      "file": "package.json",
      "op": "mergeJson",
      "target": "lib",
      "value": {
        "exports": {
          ".": "./dist/index.mjs",
          "./package.json": "./package.json"
        },
        "files": ["dist"],
        "main": "./dist/index.mjs",
        "name": "my-library",
        "size-limit": [
          {
            "limit": "10 kB",
            "path": "dist/index.mjs"
          }
        ],
        "type": "module",
        "types": "./dist/index.d.mts",
        "version": "0.0.0"
      }
    },
    {
      "file": "package.json",
      "op": "mergeJson",
      "target": "root",
      "value": {
        "scripts": {
          "build:lib": "bun run --cwd {{target:lib}} tsdown",
          "check:package": "bun run --cwd {{target:lib}} publint && bun run --cwd {{target:lib}} attw --pack . --profile esm-only",
          "compile": "bun build --compile {{target:lib}}/src/cli.ts --outfile {{target:lib}}/dist/cli",
          "size": "bun run --cwd {{target:lib}} size-limit"
        }
      }
    }
  ],
  "override": [],
  "provides": [
    {
      "capability": "library",
      "cardinality": {
        "max": 1
      }
    }
  ],
  "requires": [],
  "schemaVersion": 1,
  "version": "1.1.0"
}
