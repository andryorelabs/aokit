{
  "$schema": "https://aokit.andryore.dev/schema/module/v1.json",
  "conflicts": [],
  "deps": {
    "dependencies": {
      "@tanstack/react-form": {
        "range": "catalog"
      },
      "zod": {
        "range": "catalog"
      }
    }
  },
  "env": [],
  "extensionPoints": [],
  "files": [
    {
      "from": "files/example-form.ts.txt",
      "ownership": "seed",
      "target": "web",
      "to": "src/lib/example-form.ts"
    }
  ],
  "migrations": [],
  "name": "tanstack-form",
  "ops": [
    {
      "content": "\n## tanstack-form\n\nTanStack Form manages form state, validated with Zod schemas.\n\nKey files:\n\n- `src/lib/example-form.ts`: a form hook validated by a Zod schema, yours to extend.\n",
      "file": "AGENTS.md",
      "op": "appendRegion",
      "region": "agents",
      "target": "root"
    }
  ],
  "override": [],
  "provides": [
    {
      "capability": "forms",
      "cardinality": {
        "max": 1
      }
    }
  ],
  "requires": ["web:react"],
  "schemaVersion": 1,
  "version": "1.0.0"
}
