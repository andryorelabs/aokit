{
  "$schema": "https://aokit.andryore.dev/schema/module/v1.json",
  "conflicts": [],
  "deps": {
    "dependencies": {
      "hono": {
        "range": "catalog"
      }
    },
    "devDependencies": {
      "@types/bun": {
        "range": "catalog"
      }
    }
  },
  "env": [],
  "extensionPoints": [
    {
      "anchor": "middleware",
      "file": "src/app.ts",
      "kind": "array",
      "name": "server.middleware",
      "target": "server",
      "version": "1.0.0"
    },
    {
      "anchor": "routes",
      "file": "src/app.ts",
      "kind": "object",
      "name": "server.routes",
      "target": "server",
      "version": "1.0.0"
    }
  ],
  "files": [
    {
      "from": "files/app.ts",
      "ownership": "managed",
      "target": "server",
      "to": "src/app.ts"
    },
    {
      "from": "files/hono-add-route.SKILL.md",
      "ownership": "managed",
      "target": "root",
      "to": ".claude/skills/hono-add-route/SKILL.md"
    }
  ],
  "migrations": [],
  "name": "hono",
  "ops": [
    {
      "content": "\n## hono\n\nHono provides the HTTP server Target.\n\nCommands:\n\n- `bun run start`: start the server.\n\nKey files:\n\n- `src/app.ts`: the Hono app; add middleware and routes through its extension points.\n\nSkills:\n\n- `.claude/skills/hono-add-route/SKILL.md`: how to add a route to this server.\n",
      "file": "AGENTS.md",
      "op": "appendRegion",
      "region": "agents",
      "target": "root"
    },
    {
      "file": "package.json",
      "op": "mergeJson",
      "target": "root",
      "value": {
        "scripts": {
          "start": "bun run {{target:server}}/src/app.ts"
        }
      }
    }
  ],
  "override": [],
  "provides": [
    {
      "capability": "server",
      "cardinality": {
        "max": 1
      }
    },
    {
      "capability": "api:http",
      "cardinality": {
        "max": 1
      }
    }
  ],
  "requires": [],
  "schemaVersion": 1,
  "version": "1.1.0"
}
