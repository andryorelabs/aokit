{
  "$schema": "https://aokit.andryore.dev/schema/module/v1.json",
  "conflicts": [],
  "deps": {
    "dependencies": {
      "hono": {
        "range": "catalog"
      }
    }
  },
  "env": [],
  "extensionPoints": [],
  "files": [
    {
      "from": "files/client.ts.txt",
      "ownership": "seed",
      "target": "api-client",
      "to": "client.ts"
    }
  ],
  "migrations": [],
  "name": "hono-rpc",
  "ops": [
    {
      "content": "\n## hono-rpc\n\nHono RPC gives the api-client Target a typed client for the Hono server.\n\nKey files:\n\n- `client.ts` in the api-client directory: `createApiClient(baseUrl)` returns a `hono/client` client typed by the server's `AppType`; it re-exports `AppType`.\n",
      "file": "AGENTS.md",
      "op": "appendRegion",
      "region": "agents",
      "target": "root"
    }
  ],
  "override": [],
  "provides": [
    {
      "capability": "api:rpc",
      "cardinality": {
        "max": 1
      }
    }
  ],
  "requires": ["ext:server.routes@^1"],
  "schemaVersion": 1,
  "version": "1.0.0"
}
