  "conflicts": [],
  "env": [
    {
      "example": "postgresql://postgres:postgres@localhost:5432/app",
      "key": "DATABASE_URL",
      "scope": "root"
    }
  ],
  "extensionPoints": [],
  "files": [
    {
      "from": "files/compose.yml",
      "ownership": "managed",
      "target": "root",
