{
  "$schema": "https://aokit.andryore.dev/schema/module/v1.json",
  "conflicts": [],
  "deps": {
    "dependencies": {
      "posthog-js": {
        "range": "catalog"
      }
    }
  },
  "env": [
    {
      "example": "",
      "key": "NEXT_PUBLIC_POSTHOG_KEY",
      "scope": "web",
      "visibility": "client"
    },
    {
      "example": "https://us.i.posthog.com",
      "key": "NEXT_PUBLIC_POSTHOG_HOST",
      "scope": "web",
      "visibility": "client"
    }
  ],
  "extensionPoints": [],
  "files": [
    {
      "from": "files/src/instrumentation-client.ts",
      "ownership": "managed",
      "target": "web",
      "to": "src/instrumentation-client.ts"
    },
    {
      "from": "files/src/analytics/provider.tsx",
      "ownership": "managed",
      "target": "web",
      "to": "src/analytics/provider.tsx"
    }
  ],
  "migrations": [],
  "name": "posthog",
  "ops": [
    {
      "content": "\n## posthog\n\nPostHog product analytics for the Next web Target (Next only in v1).\n\nKey files:\n\n- `src/instrumentation-client.ts`: initializes posthog-js when `NEXT_PUBLIC_POSTHOG_KEY` is set.\n- `src/analytics/provider.tsx`: the client provider, registered through `web.providers`.\n",
      "file": "AGENTS.md",
      "op": "appendRegion",
      "region": "agents",
      "target": "root"
    },
    {
      "extensionPoint": "web.providers",
      "from": "./analytics/provider",
      "named": ["AnalyticsProvider"],
      "op": "addImport",
      "range": "^1",
      "target": "web"
    },
    {
      "element": "AnalyticsProvider",
      "extensionPoint": "web.providers",
      "op": "addToArray",
      "range": "^1",
      "target": "web"
    }
  ],
  "override": [],
  "provides": [
    {
      "capability": "analytics",
      "cardinality": {
        "max": 1
      }
    }
  ],
  "requires": ["web:app-router", "ext:web.providers@^1"],
  "schemaVersion": 1,
  "version": "1.0.0"
}
