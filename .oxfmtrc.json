{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "bun.lock",
    "**/node_modules/**",
    ".claude/**",
    ".emet/**",
    "coverage/**",
    "dist/**",
    "schema/**",
    "registry/modules/**/migrations/**",
    "registry/modules/**/files/**",
    "registry-src/*/files/**",
    "LICENSE"
  ],
  "sortImports": {
    "groups": ["builtin", "external", "internal", ["parent", "sibling", "index"], "unknown"],
    "internalPattern": ["@/"],
    "ignoreCase": true,
    "newlinesBetween": true
  }
}
