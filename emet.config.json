{
  "$schema": "https://emet.andryore.dev/schema/emet.config.schema.json",
  "version": 1,
  "repo": {
    "trunk": "develop",
    "remote": "origin"
  },
  "ticket": {
    "idPattern": "^AO-\\d+$",
    "branchPrefix": "ao"
  },
  "worktree": {
    "bootstrap": ["bun install --frozen-lockfile --silent"]
  },
  "concurrency": {
    "waveSize": 4,
    "maxLiveWorkers": "auto",
    "runIdleThresholdMs": 5400000
  },
  "tracker": {
    "kind": "linear",
    "transitions": {
      "onStart": "worker",
      "onPrOpen": "automatic",
      "onPrMerge": "automatic"
    },
    "team": "AO"
  },
  "preflight": {
    "requiredFiles": [],
    "requiredCommands": []
  },
  "handoff": {
    "maxLines": 60,
    "maxChars": 8000,
    "autoChain": true,
    "launcher": "auto",
    "permissionMode": "bypassPermissions",
    "afterSpec": "release"
  },
  "pr": {
    "autoMerge": true,
    "mergeMethod": "squash",
    "maxCiFixAttempts": 2
  },
  "usage": {
    "oversizedReadLines": 400,
    "stalledMinutes": 10
  },
  "models": {
    "worker": {
      "model": "sonnet",
      "effort": "medium"
    },
    "reviewer": {
      "medium": {
        "model": "opus",
        "effort": "medium"
      },
      "high": {
        "model": "opus",
        "effort": "medium"
      }
    },
    "triage": "haiku",
    "escalation": {
      "sonnet": "opus"
    }
  },
  "review": {
    "highRiskPaths": [
      "distribution",
      "bump.config",
      "docker",
      ".github/rulesets/"
    ]
  },
  "commands": {
    "selfCheck": ["bun run check", "bun run test"]
  },
  "language": {
    "conversation": "es",
    "artifacts": "en"
  },
  "landing": {
    "specMergeMethod": "squash"
  },
  "specs": {
    "enabled": true
  }
}
